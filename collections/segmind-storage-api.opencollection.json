{
  "opencollection": "1.0.0",
  "info": {
    "name": "Segmind Account Storage API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Storage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload a file as a reusable asset (workflows-api host)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.segmind.com/upload-asset",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Upload a file as a reusable asset (workflows-api host)"
        }
      ]
    }
  ],
  "bundled": true
}